# Minimal type stubs for the parts of pyvips this project uses (pyvips ships no types).
from collections.abc import Sequence
from typing import Self

def version(flag: int) -> int: ...

class Interpolate:
    @staticmethod
    def new(name: str) -> Interpolate: ...

class Image:
    width: int
    height: int
    bands: int
    format: str
    interpretation: str

    @staticmethod
    def new_from_file(vips_filename: str, **kwargs: object) -> Image: ...
    @staticmethod
    def new_from_memory(data: bytes, width: int, height: int, bands: int, format: str) -> Image: ...
    @staticmethod
    def thumbnail(filename: str, width: int, **kwargs: object) -> Image: ...
    @staticmethod
    def xyz(width: int, height: int, **kwargs: object) -> Image: ...
    def hasalpha(self) -> bool: ...
    def flatten(self, **kwargs: object) -> Self: ...
    def colourspace(self, space: str, **kwargs: object) -> Self: ...
    def cast(self, format: str, **kwargs: object) -> Self: ...
    def linear(
        self, a: float | Sequence[float], b: float | Sequence[float], **kwargs: object
    ) -> Self: ...
    def bandjoin(self, other: Image | Sequence[Image]) -> Self: ...
    def rot(self, angle: str) -> Self: ...
    def mapim(self, index: Image, **kwargs: object) -> Self: ...
    def affine(self, matrix: Sequence[float], **kwargs: object) -> Self: ...
    def copy_memory(self) -> Self: ...
    def copy(self, **kwargs: object) -> Self: ...
    def crop(self, left: int, top: int, width: int, height: int) -> Self: ...
    def write_to_memory(self) -> bytes: ...
    def tiffsave(self, filename: str, **kwargs: object) -> None: ...
    def jpegsave(self, filename: str, **kwargs: object) -> None: ...
    def dzsave(self, filename: str, **kwargs: object) -> None: ...
    def __getitem__(self, index: int) -> Self: ...
    def __add__(self, other: Image | float) -> Self: ...
    def __sub__(self, other: Image | float) -> Self: ...
    def __mul__(self, other: Image | float) -> Self: ...
    def __truediv__(self, other: Image | float) -> Self: ...
